generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Category {
  DESK
  LIGHTING
  ACCESSORIES
}

enum Status {
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         Role            @default(CUSTOMER)
  createdAt    DateTime        @default(now())
  cart         CartItem[]
  addresses    Address[]
  orders       Order[]
  returns      ReturnRequest[]
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  category    Category
  price       Int
  stock       Int
  images      String[]
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  cart        CartItem[]
  orderItems  OrderItem[]
  variants    ProductVariant[]

  @@index([active, category, price])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  name            String
  sku             String   @unique
  priceAdjustment Int      @default(0)
  stock           Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, active])
}

model CartItem {
  userId    String
  productId String
  variantId String  @default("base")
  quantity  Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId, variantId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  street    String
  city      String
  region    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Order {
  id            String         @id @default(cuid())
  userId        String
  checkoutKey   String
  total         Int
  discount      Int            @default(0)
  coupon        String?
  status        Status         @default(PAID)
  address       Json
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  returnRequest ReturnRequest?

  @@unique([userId, checkoutKey])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  name        String
  price       Int
  quantity    Int
  variantId   String?
  variantName String?
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String       @unique
  userId      String
  reason      String
  status      ReturnStatus @default(REQUESTED)
  adminNote   String?
  requestedAt DateTime     @default(now())
  resolvedAt  DateTime?
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}
