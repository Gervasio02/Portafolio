# Valores de ejemplo para docker compose. Copia este archivo a .env y cámbialos.
POSTGRES_USER=bodeganet
POSTGRES_PASSWORD=cambia-esta-clave-local
POSTGRES_DB=bodeganet

# Sin DATABASE_URL la app usa SQLite en un archivo local con datos de demo.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/bodeganet
# SQLITE_RUTA=datos/bodeganet.db
