@model List<FilaExistencia>
<script src="~/js/disponibilidad.js" asp-append-version="true" defer></script>
@if (Model.Count > 0)
{
    <noscript><aside class="tarjeta">
        <h2>Unidades disponibles</h2>
        <ul class="saldos">
            @foreach (var s in Model)
            {
                <li>
                    <span>@s.Bodega</span>
                    <strong>@Formato.Numero(s.Cantidad) @s.Unidad</strong>
                </li>
            }
        </ul>
    </aside></noscript>
}
