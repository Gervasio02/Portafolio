@model List<FilaExistencia>
@if (Model.Count > 0)
{
    <aside class="tarjeta">
        <h2>Saldo actual</h2>
        <ul class="saldos">
            @foreach (var s in Model)
            {
                <li>
                    <span>@s.Bodega</span>
                    <span><strong>@Formato.Numero(s.Cantidad) @s.Unidad</strong> · prom. @Formato.Costo(s.CostoPromedio)</span>
                </li>
            }
        </ul>
    </aside>
}
