@page
@model TransferenciaModel
@{
    ViewData["Title"] = "Transferir entre bodegas";
}
<div class="titulo-pagina">
    <h1>Transferir entre bodegas</h1>
    <a href="/Movimientos">Volver a movimientos</a>
</div>
<div class="rejilla-form">
    <form method="post" class="tarjeta formulario" novalidate>
        <p class="tenue">La salida del origen y la entrada al destino se guardan en la misma transacción: o quedan las dos, o ninguna. El destino recibe el costo promedio del origen.</p>
        <div asp-validation-summary="ModelOnly" class="aviso aviso-error" role="alert"></div>
        <div class="campo">
            <label asp-for="Datos.ProductoId"></label>
            <select asp-for="Datos.ProductoId" asp-items="Model.OpcionesProductos"><option value="">Elige un producto</option></select>
            <span asp-validation-for="Datos.ProductoId" class="error"></span>
        </div>
        <div class="campos-2">
            <div class="campo">
                <label asp-for="Datos.OrigenId"></label>
                <select asp-for="Datos.OrigenId" asp-items="Model.OpcionesBodegas"><option value="">Origen</option></select>
                <span asp-validation-for="Datos.OrigenId" class="error"></span>
            </div>
            <div class="campo">
                <label asp-for="Datos.DestinoId"></label>
                <select asp-for="Datos.DestinoId" asp-items="Model.OpcionesBodegas"><option value="">Destino</option></select>
                <span asp-validation-for="Datos.DestinoId" class="error"></span>
            </div>
        </div>
        <div class="campo">
            <label asp-for="Datos.Cantidad"></label>
            <input asp-for="Datos.Cantidad" type="number" min="1" step="1" inputmode="numeric" />
            <span asp-validation-for="Datos.Cantidad" class="error"></span>
        </div>
        <div class="campo">
            <label asp-for="Datos.Referencia"></label>
            <input asp-for="Datos.Referencia" placeholder="Guía de traslado 910" />
            <span asp-validation-for="Datos.Referencia" class="error"></span>
        </div>
        <div class="acciones">
            <button type="submit" class="boton">Transferir</button>
        </div>
    </form>
    <partial name="_Saldos" model="Model.Saldos" />
</div>
