@model IReadOnlyList<FilaMovimiento>
@if (Model.Count == 0)
{
    <p class="tenue">No hay movimientos para mostrar.</p>
}
else
{
    <div class="tabla">
        <table>
            <thead>
                <tr>
                    <th scope="col">Fecha</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Producto</th>
                    <th scope="col">Bodega</th>
                    <th scope="col" class="num">Cantidad</th>
                    <th scope="col" class="num">Costo unit.</th>
                    <th scope="col">Referencia</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td class="nowrap">@Formato.Fecha(m.Fecha)</td>
                        <td><span class="etiqueta tipo-@m.Tipo.ToString().ToLowerInvariant()">@Formato.Tipo(m.Tipo)</span></td>
                        <td><a href="/Kardex?productoId=@m.ProductoId&amp;bodegaId=@m.BodegaId">@m.Sku</a> <span class="tenue">@m.Producto</span></td>
                        <td>@m.Bodega</td>
                        <td class="num @(m.Cantidad < 0 ? "negativo" : "positivo")">@(m.Cantidad > 0 ? "+" : "")@Formato.Numero(m.Cantidad)</td>
                        <td class="num">@Formato.Costo(m.CostoUnitario)</td>
                        <td>@m.Referencia</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
