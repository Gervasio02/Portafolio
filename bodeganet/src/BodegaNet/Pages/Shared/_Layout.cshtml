@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var ruta = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Activo(string prefijo) => ruta == prefijo || (prefijo != "/Index" && ruta.StartsWith(prefijo + "/")) ? "activo" : "";
}
<!DOCTYPE html>
<html lang="es-CL">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content="BodegaNet: control de inventario y kardex con costo promedio ponderado. Demo con datos ficticios." />
    <title>@ViewData["Title"] · BodegaNet</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
        <a class="marca" href="/">
            <span class="marca-icono" aria-hidden="true">▦</span>
            <span>Bodega<strong>Net</strong></span>
        </a>
        @if (autenticado)
        {
            <nav class="menu" aria-label="Principal">
                <a class="@Activo("/Index")" href="/">Panel</a>
                <a class="@Activo("/Productos")" href="/Productos">Productos</a>
                <a class="@Activo("/Bodegas")" href="/Bodegas">Bodegas</a>
                <a class="@Activo("/Movimientos")" href="/Movimientos">Movimientos</a>
                <a class="@Activo("/Kardex")" href="/Kardex">Kardex</a>
                <a class="@Activo("/Alertas")" href="/Alertas">Alertas</a>
                <a class="@Activo("/Api")" href="/Api">API</a>
            </nav>
            <form class="sesion" method="post" asp-page="/Salir">
                <span class="usuario">@User.Nombre() <span class="rol">@User.Rol()</span></span>
                <button type="submit" class="boton boton-fantasma boton-chico">Salir</button>
            </form>
        }
    </header>
    <main id="contenido" class="contenido">
        @if (TempData["Aviso"] is string aviso)
        {
            <p class="aviso aviso-ok" role="status">@aviso</p>
        }
        @RenderBody()
    </main>
    <footer class="pie">
        <p>Demo con datos ficticios. La base se reinicia cuando el servidor se apaga por inactividad.</p>
        <p>ASP.NET Core 10 · Razor Pages · EF Core · <a href="/openapi/v1.json">OpenAPI</a></p>
    </footer>
</body>
</html>
