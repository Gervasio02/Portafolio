@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var ruta = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var navegacion = new (string Pagina, string Grupo, string Nombre)[]
    {
        ("/Index", "/Index", "Inicio"),
        ("/Productos/Index", "/Productos", "Productos"),
        ("/Bodegas/Index", "/Bodegas", "Bodegas"),
        ("/Movimientos/Index", "/Movimientos", "Movimientos"),
        ("/Kardex", "/Kardex", "Historial"),
        ("/Alertas", "/Alertas", "Alertas"),
    };
}
<!DOCTYPE html>
<html lang="es-CL">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content="BodegaNet: control de inventario y kardex con costo promedio ponderado. Demo con datos ficticios." />
    <title>@ViewData["Title"] · BodegaNet</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
        <a class="marca" href="/">
            <span class="marca-icono" aria-hidden="true">▦</span>
            <span>Bodega<strong>Net</strong></span>
        </a>
        @if (autenticado)
        {
            <nav class="menu" aria-label="Principal">
                @foreach (var (pagina, grupo, nombre) in navegacion)
                {
                    var seleccion = ruta == pagina ? "page" : ruta.StartsWith(grupo + "/", StringComparison.Ordinal) ? "location" : null;
                    <a asp-page="@pagina" aria-current="@seleccion">@nombre</a>
                }
            </nav>
            <form class="sesion" method="post" asp-page="/Salir">
                <span class="usuario">@User.Nombre() <span class="rol">@User.Rol()</span></span>
                <button type="submit" class="boton boton-fantasma boton-chico">Cerrar sesión</button>
            </form>
        }
    </header>
    <main id="contenido" class="contenido">
        @if (TempData["Aviso"] is string aviso)
        {
            <p class="aviso aviso-ok" role="status">@aviso</p>
        }
        @RenderBody()
    </main>
    <footer class="pie">
        <p>Modo de prueba con datos ficticios. Los cambios de la demo pueden perderse al reiniciar.</p>
    </footer>
    <a class="volver-portafolio" href="https://gervasio.sbs/#bodeganet" title="Volver al portafolio de Gervasio Torres"><span aria-hidden="true">←</span> Portafolio</a>
</body>
</html>
