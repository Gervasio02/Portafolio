@page
@model AlertasModel
@{
    ViewData["Title"] = "Productos por reponer";
}
<div class="titulo-pagina">
    <h1>Productos por reponer</h1>
</div>
<section class="tarjeta">
    <p class="tenue">Revisa cuántas unidades faltan para volver al mínimo, sumando todas las bodegas.</p>
    @if (Model.Alertas.Count == 0)
    {
        <p>Todos los productos alcanzan su mínimo de unidades.</p>
    }
    else
    {
        <ul class="reposiciones">
            @foreach (var a in Model.Alertas)
            {
                <li>
                    <h2>@a.Producto</h2>
                    <p class="tenue">@a.Sku · Hay @Formato.Numero(a.StockTotal) (@a.Unidad) de un mínimo de @Formato.Numero(a.StockMinimo).</p>
                    <p><strong>Faltan @Formato.Numero(a.Faltante) (@a.Unidad)</strong></p>
                    <div class="acciones">
                        @if (User.PuedeMover())
                        {
                            <a class="boton boton-secundario" asp-page="/Movimientos/Entrada" asp-route-productoId="@a.ProductoId">Registrar reposición</a>
                        }
                        <a class="boton boton-fantasma" asp-page="/Kardex" asp-route-productoId="@a.ProductoId">Ver historial</a>
                    </div>
                </li>
            }
        </ul>
    }
</section>
