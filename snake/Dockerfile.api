FROM node:22-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY prisma ./prisma
RUN npx prisma generate
COPY index.html tsconfig.json vite.config.ts ./
COPY src ./src
RUN npm run build
FROM deps AS runtime
COPY server ./server
ENV NODE_ENV=production
EXPOSE 3001
CMD ["npx", "tsx", "server/index.ts"]
