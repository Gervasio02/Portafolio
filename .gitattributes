# Finales de línea consistentes entre Windows (Codex/VS Code) y Linux (CI, Claude).
* text=auto eol=lf

# Scripts de Windows conservan CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.xlsx binary
*.db binary

# Migraciones: nunca tocar los bytes (Prisma/Alembic guardan checksums).
**/migrations/** -text
